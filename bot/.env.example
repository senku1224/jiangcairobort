# 复制为 bot/.env 后按需修改。bot/.env 已被 .gitignore 忽略，不会上传。

# ── NapCat / OneBot ─────────────────────────────
# NapCat 的 HTTP 服务器地址（用于我们主动发消息）
ONEBOT_API=http://127.0.0.1:3000
# 与 NapCat 配置一致的 access token，没有就留空
ONEBOT_TOKEN=
# 我们接收 NapCat「HTTP 上报」的端口与路径
BOT_PORT=8790
BOT_PATH=/onebot
# 只在这些群响应（QQ 群号，逗号分隔）；留空=所有群
ALLOWED_GROUPS=
# 指令前缀，例如设为 / 或 !；留空时也支持以 / 开头触发
COMMAND_PREFIX=

# ── Supabase ────────────────────────────────────
SUPABASE_URL=https://cvuqgcuwfgpttgklkwiy.supabase.co
# 公开的 publishable key，用于读取（/招募 等）
SUPABASE_KEY=sb_publishable_89rNeFjm8oZHqOnWKbQKgg_DvjjvMH6
# 服务端密钥，用于写入（/绑定 /报名 /取消）。
# 在 Supabase 控制台 → Project Settings → API → 「service_role」那一行复制（标着 secret）。
# 只填在本机这个 bot/.env 里，绝不提交到仓库、绝不发到聊天、绝不放进前端。
# 留空则只读：/绑定 /报名 /取消 /我的 会提示"未配置写入密钥"。
SUPABASE_SERVICE_KEY=

# 访问 Supabase 的 HTTP 代理（可选）。本机直连 Cloudflare 被重置时填，例如 http://127.0.0.1:50996
BOT_PROXY=

# 招募网站地址（回复里展示给群友）
SITE_URL=https://senku1224.github.io/jiangcairobort/
